<div class="container mt-5">
  <h2 class="text-center mb-4">会員情報編集</h2>

  <%= form_with model: @customer, url: customers_update_path, method: :patch, local: true do |f| %>
    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">氏名</label>
      <div class="col-sm-5"><%= f.text_field :last_name, class: "form-control" %></div>
      <div class="col-sm-5"><%= f.text_field :first_name, class: "form-control" %></div>
    </div>

    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">フリガナ</label>
      <div class="col-sm-5"><%= f.text_field :last_name_kana, class: "form-control" %></div>
      <div class="col-sm-5"><%= f.text_field :first_name_kana, class: "form-control" %></div>
    </div>

    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">郵便番号</label>
      <div class="col-sm-10"><%= f.text_field :postal_code, class: "form-control" %></div>
    </div>

    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">住所</label>
      <div class="col-sm-10"><%= f.text_field :address, class: "form-control" %></div>
    </div>

    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">電話番号</label>
      <div class="col-sm-10"><%= f.text_field :phone_number, class: "form-control" %></div>
    </div>

    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">メールアドレス</label>
      <div class="col-sm-10"><%= f.email_field :email, class: "form-control" %></div>
    </div>

    <div class="d-flex justify-content-center mt-4">
      <%= f.submit "編集内容を保存", class: "btn btn-success me-3" %>
      <%= link_to "退会する", customers_unsubscribe_path, class: "btn btn-danger" %>
    </div>
  <% end %>
</div>