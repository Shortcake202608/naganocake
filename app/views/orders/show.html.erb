<div class="container mt-5">
  <h4 class="mb-4">注文履歴詳細</h4>

  <!-- 注文情報と請求情報 -->
  <div class="row">
    <!-- 注文情報 -->
    <div class="col-md-6">
      <h5 class="mb-3">注文情報</h5>
      <table class="table table-bordered">
        <tr>
          <th>注文日</th>
          <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
        </tr>
        <tr>
          <th>配送先</th>
          <td>
            〒<%= @order.postal_code %> <%= @order.address %><br>
            <%= @order.name %>
          </td>
        </tr>
        <tr>
          <th>支払方法</th>
          <td><%= @order.payment_method_i18n %></td>
        </tr>
        <tr>
          <th>ステータス</th>
          <td><%= @order.status_i18n %></td>
        </tr>
      </table>
    </div>

    <!-- 請求情報 -->
    <div class="col-md-6">
      <h5 class="mb-3">請求情報</h5>
      <table class="table table-bordered">
        <tr>
          <th>商品合計</th>
          <td><%= number_to_currency(@order.total_payment - @order.shipping_cost, unit: "", precision: 0) %></td>
        </tr>
        <tr>
          <th>配送料</th>
          <td><%= number_to_currency(@order.shipping_cost, unit: "", precision: 0) %></td>
        </tr>
        <tr>
          <th>ご請求額</th>
          <td><%= number_to_currency(@order.total_payment, unit: "", precision: 0) %></td>
        </tr>
      </table>
    </div>
  </div>

  <!-- 注文内容 -->
  <h5 class="mt-4 mb-3">注文内容</h5>
  <table class="table table-bordered align-middle">
    <thead class="table-light">
      <tr>
        <th>商品</th>
        <th>単価（税込）</th>
        <th>個数</th>
        <th>小計</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_details.each do |order_detail| %>
        <tr>
          <td><%= order_detail.item.name %></td>
          <td><%= number_to_currency(order_detail.item.price, unit: "", precision: 0) %></td>
          <td><%= order_detail.amount %></td>
          <td><%= number_to_currency(order_detail.item.price * order_detail.amount, unit: "", precision: 0) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

