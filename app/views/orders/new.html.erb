<div class="container mt-5">
  <h4 class="mb-4">注文情報入力</h4>

  <%= form_with model: @order, url: confirm_orders_path, method: :post, data: { turbo: false } do |f| %>

    <!-- 支払方法 -->
    <h5 class="mb-3">支払方法</h5>
    <div class="form-check mb-2">
      <%= f.radio_button :payment_method, "credit_card", checked: true, class: "form-check-input" %>
      <%= f.label :payment_method_credit_card, "クレジットカード", class: "form-check-label" %>
    </div>
    <div class="form-check mb-4">
      <%= f.radio_button :payment_method, "transfer", class: "form-check-input" %>
      <%= f.label :payment_method_transfer, "銀行振込", class: "form-check-label" %>
    </div>

    <!-- お届け先 -->
    <h5 class="mb-3">お届け先</h5>

    <div class="form-check mb-2">
      <%= f.radio_button :select_address, "own", checked: true, class: "form-check-input" %>
      <%= f.label :select_address_own, "ご自身の住所", class: "form-check-label" %>
      <div class="ms-4">
        〒<%= current_customer.postal_code %> <%= current_customer.address %><br>
        <%= current_customer.last_name %><%= current_customer.first_name %>
      </div>
    </div>

    <div class="form-check mb-2">
      <%= f.radio_button :select_address, "registered", class: "form-check-input" %>
      <%= f.label :select_address_registered, "登録済住所から選択", class: "form-check-label" %>
      <div class="ms-4">
        <%= f.select :address_id, options_from_collection_for_select(@addresses, :id, :full_address), {}, class: "form-select w-auto" %>
      </div>
    </div>

    <div class="form-check mb-3">
      <%= f.radio_button :select_address, "new", class: "form-check-input" %>
      <%= f.label :select_address_new, "新しいお届け先", class: "form-check-label" %>
      <div class="ms-4 mt-2" style="max-width: 500px;">
        <div class="mb-2">
          <%= f.label :postal_code, "郵便番号（ハイフンなし）", class: "form-label" %>
          <%= f.text_field :postal_code, class: "form-control", placeholder: "0000000" %>
        </div>
        <div class="mb-2">
          <%= f.label :address, "住所", class: "form-label" %>
          <%= f.text_field :address, class: "form-control", placeholder: "東京都渋谷区代々木神園町0-0" %>
        </div>
        <div class="mb-2">
          <%= f.label :name, "宛名", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", placeholder: "令和道子" %>
        </div>
      </div>
    </div>

    <!-- 確認ボタン -->
    <div class="text-center mt-4">
      <%= f.submit "確認画面へ進む", class: "btn btn-primary text-white px-4" %>
    </div>

  <% end %>
</div>

