<header class="bg-white py-3 border-bottom">
  <div class="container d-flex justify-content-between align-items-center">
    <div class="logo">
      <%= link_to admin_root_path do %>
        <%= image_tag "logo.png", alt: "LOGO", style: "height:70px;" %>
      <% end %>
    </div>

    <div class="d-flex align-items-center gap-3">
      <span class="fw-bold text-dark">管理者メニュー</span>
      <%= link_to "商品一覧", admin_items_path, class: "btn btn-outline-secondary" %>
      <%= link_to "会員一覧", admin_customers_path, class: "btn btn-outline-secondary" %>
      <%= link_to "注文履歴一覧", admin_root_path, class: "btn btn-outline-secondary" %>
      <%= link_to "ジャンル一覧", admin_genres_path, class: "btn btn-outline-secondary" %>
      <%= link_to "ログアウト", destroy_admin_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-danger" %>
    </div>
  </div>
</header>
