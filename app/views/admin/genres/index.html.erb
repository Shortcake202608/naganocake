<div class="container my-5">

  <h2 class="text-center mb-4 bg-light py-2">ジャンル一覧・追加</h2>

  <!-- 新規登録フォーム -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="w-50">
      <%= form_with model: @genre, url: admin_genres_path, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :name, "ジャンル名", class: "fw-bold" %>
          <%= f.text_field :name, placeholder: "ジャンル名", class: "form-control" %>
        </div>
        <%= f.submit "新規登録", class: "btn btn-success px-4 py-2" %>
      <% end %>
    </div>
  </div>

  <!-- ジャンル一覧 -->
  <table class="table table-bordered">
    <thead class="table-light">
      <tr>
        <th>ジャンル</th>
        <th class="text-center">編集</th>
      </tr>
    </thead>
    <tbody>
      <% @genres.each do |genre| %>
        <tr>
          <td><%= genre.name %></td>
          <td class="text-center">
            <%= link_to "編集する", admin_genres_path(id: genre.id), class: "btn btn-success" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>

