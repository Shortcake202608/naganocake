<div class="container mt-5">
  <div class="card p-4 shadow-sm mx-auto" style="max-width: 800px;">
    <h4 class="fw-bold mb-4">会員一覧</h4>

    <table class="table table-bordered table-hover align-middle text-center w-100">
      <thead class="table-light">
        <tr>
          <th>会員ID</th>
          <th>氏名</th>
          <th>メールアドレス</th>
          <th>ステータス</th>
        </tr>
      </thead>

      <tbody>
        <% @customers.each_with_index do |customer, i| %>
          <tr>
            <td><%= i + 1 %></td>
            <td>
              <%= link_to "#{customer.last_name}#{customer.first_name}", admin_customer_path(customer), class: "text-decoration-none fw-semibold text-primary" %>
            </td>
            <td><%= customer.email %></td>
            <td class="<%= customer.is_active ? 'text-success fw-bold' : 'text-secondary fw-bold' %>">
              <%= customer.is_active ? "有効" : "退会" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>