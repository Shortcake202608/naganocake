<div class="container mt-5">
  <h4 class="mb-4"><%= @customer.last_name %><%= @customer.first_name %>さんの会員情報編集</h4>

  <%= form_with model: @customer, url: admin_customer_path(@customer), method: :patch, local: true do |f| %>
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">会員ID</label>
      <div class="col-sm-10 pt-2"><%= @customer.id %></div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">氏名</label>
      <div class="col-sm-5"><%= f.text_field :last_name, class: "form-control" %></div>
      <div class="col-sm-5"><%= f.text_field :first_name, class: "form-control" %></div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">フリガナ</label>
      <div class="col-sm-5"><%= f.text_field :last_name_kana, class: "form-control" %></div>
      <div class="col-sm-5"><%= f.text_field :first_name_kana, class: "form-control" %></div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">郵便番号</label>
      <div class="col-sm-10"><%= f.text_field :postal_code, class: "form-control" %></div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">住所</label>
      <div class="col-sm-10"><%= f.text_field :address, class: "form-control" %></div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">電話番号</label>
      <div class="col-sm-10"><%= f.text_field :telephone_number, class: "form-control" %></div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">メールアドレス</label>
      <div class="col-sm-10"><%= f.email_field :email, class: "form-control" %></div>
    </div>

    <div class="row mb-4">
      <label class="col-sm-2 col-form-label">会員ステータス</label>
      <div class="col-sm-10">
        <div class="form-check form-check-inline">
          <%= f.radio_button :is_active, true, class: "form-check-input" %>
          <%= f.label :is_active, "有効", class: "form-check-label" %>
        </div>
        <div class="form-check form-check-inline">
          <%= f.radio_button :is_active, false, class: "form-check-input" %>
          <%= f.label :is_active, "退会", class: "form-check-label" %>
        </div>
      </div>
    </div>

    <div class="text-center">
      <%= f.submit "変更を保存", class: "btn btn-success text-white px-4 py-2" %>
    </div>
  <% end %>
</div>