<div class="container mt-5">
  <h4 class="mb-4">注文履歴詳細</h4>

  <!-- 注文情報 -->
  <table class="table table-borderless mb-4">
    <tr>
      <th>購入者</th>
      <td><%= @order.customer.last_name %><%= @order.customer.first_name %></td>
    </tr>
    <tr>
      <th>注文日</th>
      <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
    </tr>
    <tr>
      <th>配送先</th>
      <td>
        〒<%= @order.postal_code %> <%= @order.address %><br>
        <%= @order.name %>
      </td>
    </tr>
    <tr>
      <th>支払方法</th>
      <td><%= @order.payment_method_i18n %></td>
    </tr>
    <tr>
      <th>注文ステータス</th>
      <td>
        <%= form_with model: @order, url: admin_order_path(@order), method: :patch, local: true do |f| %>
          <div class="d-flex align-items-center">
            <%= f.select :status, Order.statuses_i18n.invert, {}, class: "form-select w-auto me-2" %>
            <%= f.submit "更新", class: "btn btn-success text-white" %>
          </div>
        <% end %>
      </td>
    </tr>
  </table>

  <!-- 注文商品一覧 -->
  <table class="table table-bordered align-middle">
    <thead class="table-light">
      <tr>
        <th>商品名</th>
        <th>単価（税込）</th>
        <th>数量</th>
        <th>小計</th>
        <th>製作ステータス</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_details.each do |order_detail| %>
        <tr>
          <td><%= order_detail.item.name %></td>
          <td><%= number_with_delimiter(order_detail.item.price_with_tax) %></td>
          <td><%= order_detail.amount %></td>
          <td><%= number_with_delimiter(order_detail.subtotal) %></td>
          <td>
            <%= form_with model: order_detail, 
                          url: admin_order_detail_path(order_detail), 
                          method: :patch,
                          local: true do |f| %>
              <div class="d-flex align-items-center">
                <%= f.select :making_status, OrderDetail.making_statuses_i18n.invert, {}, class: "form-select w-auto me-2" %>
                <%= f.submit "更新", class: "btn btn-success text-white btn-sm" %>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- 合計金額 -->
  <div class="text-end mt-4">
    <p>商品合計 <%= number_to_currency(@order.total_payment - @order.shipping_cost, unit: "", precision: 0) %>円</p>
    <p>送料 <%= number_to_currency(@order.shipping_cost, unit: "", precision: 0) %>円</p>
    <h5>請求金額合計 <%= number_to_currency(@order.total_payment, unit: "", precision: 0) %>円</h5>
  </div>
</div>
