<div class="d-flex justify-content-center mt-5">
  <div class="card shadow-sm p-4" style="width: 900px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">商品一覧</h4>

      <%= link_to new_admin_item_path, class: "btn btn-success d-flex align-items-center gap-2" do %>
        <i class="bi bi-plus-lg"></i> 新規商品追加
      <% end %>
    </div>

    <table class="table table-bordered table-hover align-middle text-center">
      <thead class="table-light">
        <tr>
          <th>商品ID</th>
          <th>商品名</th>
          <th>税抜き価格</th>
          <th>ジャンル</th>
          <th>ステータス</th>
        </tr>
      </thead>

      <tbody>
        <% @items.each_with_index do |item, i| %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= link_to item.name, admin_item_path(item), class: "text-decoration-none fw-semibold" %></td>
            <td><%= number_to_currency(item.price, unit: "", precision: 0) %></td>
            <td><%= item.genre.name %></td>
            <td class="<%= item.is_active ? 'text-success fw-bold' : 'text-secondary' %>">
              <%= item.is_active ? "販売中" : "販売停止中" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

  </div>
</div>
