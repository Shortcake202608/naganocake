<h4 class="fw-bold mb-4">商品詳細</h4>

<div class="container mt-5">
  <div class="row align-items-start">

    <!-- 左：商品画像 -->
    <div class="col-md-4 text-center">
      <%= image_tag @item.image, class: "item-detail-img" %>
    </div>

    <!-- 右：商品情報 -->
    <div class="col-md-8">
      <p><strong>商品名：</strong><%= @item.name %></p>
      <p><strong>商品説明：</strong><%= @item.description %></p>
      <p><strong>ジャンル：</strong><%= @item.genre.name %></p>
      <p><strong>税込価格(税抜価格)：</strong>
        <%= number_to_currency((@item.price * 1.1).floor, unit: "", precision: 0) %>
        (<%= number_to_currency(@item.price, unit: "", precision: 0) %>)円
      </p>
      <p><strong>販売ステータス：</strong>
        <span class="<%= @item.is_active ? 'text-success fw-bold' : 'text-secondary' %>">
          <%= @item.is_active ? "販売中" : "販売停止中" %>
        </span>
      </p>

      <%= link_to "編集する", edit_admin_item_path(@item), class: "btn btn-success text-white px-4 py-2 mt-3" %>
    </div>

  </div>
</div>
