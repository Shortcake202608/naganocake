<div class="container mt-5">
  <h4 class="mb-4">配送先編集</h4>

  <%= form_with model: @address, url: address_path(@address), method: :patch, local: true do |f| %>
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">郵便番号（ハイフンなし）</label>
      <div class="col-sm-4">
        <%= f.text_field :postal_code, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">住所</label>
      <div class="col-sm-8">
        <%= f.text_field :address, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-4">
      <label class="col-sm-2 col-form-label">宛名</label>
      <div class="col-sm-4">
        <%= f.text_field :name, class: "form-control" %>
      </div>
      <div class="col-sm-3">
        <%= f.submit "変更内容を保存", class: "btn btn-success text-white w-100" %>
      </div>
    </div>
  <% end %>
</div>
